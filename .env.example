# Hermes' local Dashboard API. Hermes uses port 9119 by default.
# Change this if your `hermes dashboard` instance uses another port.
HERMES_API_TARGET=http://127.0.0.1:9119

# Leave unset to use the Vite proxy above. A deployed dashboard can set a
# same-origin API prefix here instead.
# VITE_HERMES_API_BASE=/hermes
